PORT=5050

# Connection string for MongoDB. Required.
# Local install (default after `brew services start mongodb-community`):
MONGODB_URI=mongodb://127.0.0.1:27017/taskflow

# MongoDB Atlas alternative:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/taskflow

# Set to true to use a throwaway in-memory MongoDB (handy for demos with no install).
# USE_MEMORY_DB=true

NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
